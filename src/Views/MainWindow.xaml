<Window x:Class="SnipIt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipIt" Width="540" Height="780" MinWidth="480" MinHeight="520"
        FontFamily="Malgun Gothic" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SurfaceBrush}" StateChanged="Window_StateChanged"
        Closing="Window_Closing" Icon="pack://application:,,,/Assets/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="28,24,28,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Background="{StaticResource PrimaryBrush}" CornerRadius="11">
                    <Path Data="M 0,7 L 0,0 7,0 M 13,0 L 20,0 20,7 M 20,13 L 20,20 13,20 M 7,20 L 0,20 0,13"
                          Stroke="White" StrokeThickness="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SnipIt" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E8F3ED" CornerRadius="12" Padding="10,5">
                <TextBlock Text="캡처 준비 완료" FontSize="11" Foreground="#247A4A"/>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,8,28,20">
                <TextBlock Text="필요한 순간을,&#10;간편하게 담아보세요" FontSize="27" FontWeight="Bold" LineHeight="38" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="캡처하고, 다듬고, 바로 공유하세요." FontSize="13" Margin="0,10,0,24" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button x:Name="BtnRegion" Style="{StaticResource PrimaryButtonStyle}" Padding="24,22" Click="BtnRegion_Click" AutomationProperties.Name="영역 선택 캡처">
                    <StackPanel>
                        <TextBlock Text="영역 선택으로 시작하기" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="원하는 부분만 드래그해 주세요" FontSize="12" Margin="0,6,0,14" Foreground="#E2EEFF"/>
                        <TextBlock x:Name="RegionShortcutText" FontSize="12" Text="Ctrl + Shift + C" Foreground="White"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="다른 방법으로 캡처" FontSize="12" FontWeight="SemiBold" Margin="2,26,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button x:Name="BtnFullScreen" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,8" Click="BtnFullScreen_Click" AutomationProperties.Name="전체 화면 캡처">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" FontSize="21" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="전체 화면" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="모든 모니터를 한 번에" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="FullScreenShortcutText" Text="PrtSc" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Button>
                <Button x:Name="BtnActiveWindow" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,8" Click="BtnActiveWindow_Click" AutomationProperties.Name="활성 창 캡처">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE737;" FontSize="21" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="활성 창" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="사용하던 창만 깔끔하게" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="ActiveWindowShortcutText" Text="Alt + PrtSc" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Button>
                <Button x:Name="BtnGifRecord" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,0" Click="BtnGifRecord_Click" AutomationProperties.Name="GIF 녹화">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="21" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="GIF 녹화" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="움직이는 화면도 간편하게" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="GifShortcutText" Text="Ctrl + Shift + G" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" Padding="28,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="단축키는 설정에서 바꿀 수 있어요" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BtnHelp" Content="도움말" Style="{StaticResource SecondaryButtonStyle}" Padding="12,9" Click="BtnHelp_Click" Margin="0,0,6,0" FontSize="12"/>
                    <Button x:Name="BtnSettings" Content="설정" Style="{StaticResource SecondaryButtonStyle}" Padding="14,9" Click="BtnSettings_Click" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
