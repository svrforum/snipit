<Window x:Class="SnipIt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipIt" Width="400" Height="370" MinWidth="360" MinHeight="340"
        FontFamily="Malgun Gothic" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SurfaceBrush}" StateChanged="Window_StateChanged"
        Closing="Window_Closing" Icon="pack://application:,,,/Assets/icon.ico">
    <Grid Margin="16,10,16,12">
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <Grid>
            <Image Source="pack://application:,,,/SnipIt;component/Assets/brand-icon.png" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Margin="34,0,0,0" Text="SnipIt" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="빠른 캡처" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,4,0,8">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Button x:Name="BtnRegion" Style="{StaticResource PrimaryButtonStyle}" Padding="12,8" Margin="0,0,0,5" Click="BtnRegion_Click" AutomationProperties.Name="영역 선택 캡처">
                <Grid Width="286"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="영역 선택" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" x:Name="RegionShortcutText" Text="Ctrl + Shift + C" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Button x:Name="BtnFullScreen" Grid.Row="1" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,0,5" Click="BtnFullScreen_Click">
                <Grid Width="286"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="전체 화면" FontSize="13"/>
                    <TextBlock Grid.Column="1" x:Name="FullScreenShortcutText" Text="PrtSc" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Button x:Name="BtnActiveWindow" Grid.Row="2" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,0,5" Click="BtnActiveWindow_Click">
                <Grid Width="286"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="활성 창" FontSize="13"/>
                    <TextBlock Grid.Column="1" x:Name="ActiveWindowShortcutText" Text="Alt + PrtSc" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Button x:Name="BtnGifRecord" Grid.Row="3" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Click="BtnGifRecord_Click">
                <Grid Width="286"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="GIF 녹화" FontSize="13"/>
                    <TextBlock Grid.Column="1" x:Name="GifShortcutText" Text="Ctrl + Shift + G" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>
        <Grid Grid.Row="2">
            <Button Content="업데이트" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="10,6" Click="Update_Click"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="BtnHelp" Content="도움말" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="10,6" Click="BtnHelp_Click" Margin="0,0,6,0"/>
                <Button x:Name="BtnSettings" Content="설정" Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="10,6" Click="BtnSettings_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
