<Window x:Class="SnipIt.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipIt 업데이트" Width="540" Height="570" MinWidth="460" MinHeight="460"
        FontFamily="Malgun Gothic" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="더 좋아진 SnipIt" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding CurrentVersion, StringFormat=현재 버전 v{0}}" Margin="0,8,0,18" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="{Binding AvailableVersion}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,16">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="22"/>
            <ProgressBar Height="4" Margin="0,12,0,0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
        </StackPanel>
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" FontSize="12" LineHeight="21" Foreground="{StaticResource TextSecondaryBrush}"/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="편집 창을 닫고 녹화 저장을 마친 후 설치해 주세요.&#10;설정과 캡처 이력은 그대로 유지됩니다." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
            <WrapPanel>
                <Button Content="새 버전 확인" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10" Margin="0,0,6,6" IsEnabled="{Binding CanCheck}" Click="Check_Click"/>
                <Button Content="다운로드" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10" Margin="0,0,6,6" IsEnabled="{Binding CanDownload}" Click="Download_Click"/>
                <Button Content="취소" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10" Margin="0,0,0,6" IsEnabled="{Binding IsBusy}" Click="Cancel_Click"/>
            </WrapPanel>
            <Button Content="업데이트 후 재시작" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanInstall}" Click="Install_Click"/>
        </StackPanel>
    </Grid>
</Window>
